#Write a Python program to calculate (a + b) * c ** 2 and check whether the result is greater than 500.

a = int(input("Enter first number: "))
b = int(input("Enter second number: "))
c = int(input("Enter third number: "))

result = (a + b) * c ** 2

print("Result:", result)

if result > 500:
    print("Result is greater than 500")
else:
    print("Result is not greater than 500")
print("-----------------")    

#Write a Python program to perform multiple arithmetic and assignment operations on a number and check the final result.

num = int(input("Enter a number: "))

num += 10
num *= 2
num -= 5
num //= 2
num **= 2

print("Final result:", num)

if num > 100:
    print("Final result is greater than 100")
else:
    print("Final result is not greater than 100")
